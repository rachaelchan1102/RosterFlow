# Copy this file to .env (same folder) and fill in both values. .env is gitignored — never commit it.
# Leave either blank and the app runs on sample data only ("Coordinator login unavailable").

# The DATABASE_URL value from Vercel → Storage → your Neon database (starts with postgresql://).
# On Vercel itself, set this in the project's Environment Variables instead (see docs/DEPLOY.md).
NEON_DSN=

# The shared password coordinators type into the login dialog. Pick anything.
COORDINATOR_PASSWORD=
